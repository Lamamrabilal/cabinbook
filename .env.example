# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,cabinbook.fr
FRONTEND_URL=https://cabinbook.fr

# Database
POSTGRES_DB=cabinbook
POSTGRES_USER=cabinbook
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_CABINET=price_...

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+33...
# WhatsApp Business (optionnel) — laisser vide si non activé sur Twilio
TWILIO_WHATSAPP_FROM_NUMBER=

# SendGrid (Email)
SENDGRID_API_KEY=SG...
DEFAULT_FROM_EMAIL=noreply@cabinbook.fr

# CORS
CORS_ALLOWED_ORIGINS=https://cabinbook.fr
FIELD_ENCRYPTION_KEY=REMPLACER_generer_avec_Fernet.generate_key

# Google Calendar (synchro agenda praticien) — à créer dans Google Cloud
# Console (identifiants OAuth 2.0, type "Application web"). L'URI de
# redirection autorisée doit correspondre exactement à GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cabinbook.fr/api/accounts/calendar/google/callback/

# Sentry (monitoring d'erreurs) — laisser vide pour désactiver (dev local).
# Choisir un projet hébergé en région EU sur sentry.io pour rester cohérent
# avec le RGPD (ou une instance self-hosted).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
